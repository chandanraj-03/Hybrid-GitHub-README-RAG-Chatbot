# =======================================================
# Hybrid GitHub README RAG - Backend Config (Multi-Provider)
# =======================================================

# 1. GitHub Configuration
GITHUB_REPO_URL=https://github.com/tiangolo/fastapi
GITHUB_BRANCH=
GITHUB_TOKEN=

# 2. Local Laptop LLM Configuration (Primary)
LAPTOP_API_URL=http://localhost:16036
LAPTOP_API_TOKEN=secret-laptop-token
LOCAL_LLM_TIMEOUT=25.0

# 3. Cloud Fallback Tier 1: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 4. Cloud Fallback Tier 2: Groq Cloud (Ultra-Fast Free Tier)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 5. Cloud Fallback Tier 3: xAI Grok
GROK_API_KEY=
GROK_MODEL=grok-2

# 6. Cloud Fallback Tier 4: OpenRouter (Multi-Model)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# Fallback Cascade Execution Order
FALLBACK_CASCADE_ORDER=local,groq,openrouter,gemini,grok

# 6. RAG Pipeline Configuration
TOP_K_CHUNKS=4
EMBEDDING_PROVIDER=fast
