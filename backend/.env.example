# =======================================================
# Hybrid GitHub README RAG - Backend Config (Multi-Provider)
# =======================================================

# 1. GitHub Configuration
GITHUB_REPO_URL=https://github.com/tiangolo/fastapi
GITHUB_BRANCH=
GITHUB_TOKEN=

# 2. Local Laptop LLM Configuration (Primary)
LAPTOP_API_URL=http://localhost:8000
LAPTOP_API_TOKEN=secret-laptop-token
LOCAL_LLM_TIMEOUT=4.0

# 3. Cloud Fallback Tier 1: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 4. Cloud Fallback Tier 2: xAI Grok
GROK_API_KEY=
GROK_MODEL=grok-2-latest

# 5. Cloud Fallback Tier 3: OpenRouter (Multi-Model)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# 6. Cloud Fallback Tier 4: Groq Cloud (Ultra-fast LPU)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback Cascade Execution Order
FALLBACK_CASCADE_ORDER=local,gemini,grok,openrouter,groq

# 7. RAG Pipeline Configuration
TOP_K_CHUNKS=4
EMBEDDING_PROVIDER=sentence_transformers
