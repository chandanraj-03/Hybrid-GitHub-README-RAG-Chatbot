# ==========================================
# Hybrid GitHub README RAG - Laptop Config
# ==========================================

# 1. Model Name
# Recommended lightweight options:
# - Qwen/Qwen2.5-0.5B-Instruct
# - TinyLlama/TinyLlama-1.1B-Chat-v1.0
LOCAL_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct

# 2. Authentication Token
# Must match LAPTOP_API_TOKEN in backend
LAPTOP_API_TOKEN=secret-laptop-token

# 3. Server Port & Device
PORT=8000
DEVICE=auto
MAX_NEW_TOKENS=512
TEMPERATURE=0.2
USE_LIGHTWEIGHT_ENGINE=false
